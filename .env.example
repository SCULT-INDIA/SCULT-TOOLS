# Public site URL — used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://tools.scult.in
# Parent agency site — every conversion link points here.
NEXT_PUBLIC_PARENT_URL=https://scult.in
# GA4 — same property as the parent site so tools->agency is one session.
NEXT_PUBLIC_GA_ID=G-ZM37DBD28V
# Microsoft Clarity project ID — heatmaps and session replay. Leave UNSET in
# local dev and preview deployments: every environment that sets this writes
# into the same recording pool, and dev sessions would drown the real ones.
NEXT_PUBLIC_CLARITY_ID=
# Google PageSpeed Insights API key (free, 25k requests/day) — used by the
# Website Speed Test. Without it, the tool still works on Google's small
# keyless quota. Get one at https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=

# Resend (https://resend.com) API key — server-only, powers the "Feedback"
# button on every tool page (app/api/feedback/route.ts). Never exposed to the
# client. Without it, feedback submissions fail with a clean 502.
RESEND_API_KEY=
# The "From" address Resend sends as. Requires a domain verified in your
# Resend account (e.g. "Scult Tools <feedback@tools.scult.in>") — until then,
# leave unset to fall back to Resend's sandbox sender, which only delivers to
# the email address on the Resend account itself.
FEEDBACK_FROM_EMAIL=
# Where every feedback submission is sent. Defaults to connect@scult.in.
FEEDBACK_TO_EMAIL=
