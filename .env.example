# Public site URL — used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://tools.scult.in
# Parent agency site — every conversion link points here.
NEXT_PUBLIC_PARENT_URL=https://scult.in
# GA4 — same property as the parent site so tools->agency is one session.
NEXT_PUBLIC_GA_ID=G-ZM37DBD28V
# Microsoft Clarity project ID — heatmaps and session replay. Leave UNSET in
# local dev and preview deployments: every environment that sets this writes
# into the same recording pool, and dev sessions would drown the real ones.
NEXT_PUBLIC_CLARITY_ID=
# SCULT Studio (studio.scult.in) site id for its tracking snippet
# (components/layout/DeferredAnalyticsScripts.tsx) — "scult_tools" in
# production. Same reasoning as NEXT_PUBLIC_CLARITY_ID above: leave UNSET in
# local dev and preview deployments so that traffic doesn't land in Studio.
NEXT_PUBLIC_STUDIO_SITE=
# OpenAI Ads (ChatGPT Ads) Measurement Pixel id — reports the "book a
# meeting" CTA click as a lead conversion (lib/analytics.ts's
# trackCtaClick/trackAdsConversion). Get it from OpenAI Ads Manager
# (Settings → Conversions → your pixel). Same reasoning as
# NEXT_PUBLIC_CLARITY_ID above: leave UNSET in local dev and preview
# deployments so test clicks don't report fake conversions to a live ad
# account. Set in production to 3KgLaSRsFBPrFNq3idZUZs ("My first pixel",
# requested by Saksham Gupta on 2026-09-03).
NEXT_PUBLIC_OPENAI_ADS_PIXEL_ID=
# Google PageSpeed Insights API key (free, 25k requests/day) — used by the
# Website Speed Test. Without it, the tool still works on Google's small
# keyless quota. Get one at https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=

# SCULT Studio (studio.scult.in) API key — server-only, scoped to
# "SCULT Tools" (Studio → API → Generate a new key). Powers the per-tool
# "Feedback" button (app/api/feedback/route.ts) and the "Request a
# tool/prompt/skill" form (app/api/request/route.ts), both via lib/studio.ts.
# Never exposed to the client. Without it, submissions fail with a clean 502.
SCULT_STUDIO_API_KEY=

# Supabase (Skills Library reads) — the ANON key only: RLS makes both skills
# tables select-only for it, so the main app structurally cannot write. The
# service_role key must NEVER be set on this app — it belongs exclusively to
# the vercel-skills-sync worker project (see vercel-skills-sync/README.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Direct Postgres connection for migrations/ops scripts (never used by the
# running app). Note: the db.<ref>.supabase.co host is IPv6-only — from an
# IPv4 network use the session pooler host instead.
SUPABASE_DB_URL=
